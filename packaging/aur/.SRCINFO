pkgbase = fuzzy-file-finder
	pkgdesc = Terminal file finder and manager with fuzzy filtering, content search and Neovim editing (fff)
	pkgver = 0.19.0
	pkgrel = 1
	url = https://github.com/Frankwii/fff
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-only
	makedepends = cargo
	depends = neovim
	depends = libarchive
	depends = libgcc
	depends = glibc
	optdepends = xdg-utils: make fff the default for folders (fff setup --desktop)
