# Marks, a copy into another folder, the trash and undo.
Output docs/demos/operations.gif
Require fff
Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 16
Set Width 1280
Set Height 720
Set Padding 16
Set Theme "Catppuccin Mocha"
Set TypingSpeed 90ms

Hide
Type "source docs/demos/env.sh && clear"
Enter
Show

Type "fff" Sleep 400ms Enter Sleep 1.5s
Type "i" Sleep 300ms Type "down" Sleep 600ms Escape Sleep 300ms Escape Sleep 300ms
Type "l" Sleep 1s
Space Sleep 600ms Space Sleep 600ms Space Sleep 1s
Type "h" Sleep 800ms
Type "i" Sleep 300ms Type "notes" Sleep 600ms Escape Sleep 300ms Escape Sleep 300ms
Type "l" Sleep 1s
Type "p" Sleep 2s
Type "x" Sleep 2s
Type "u" Sleep 2s
Type "u" Sleep 2s
Type "q" Sleep 800ms
