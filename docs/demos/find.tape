# Fuzzy finding a few levels down, then leaving into the file's folder.
Output docs/demos/find.gif
Require fff
Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 16
Set Width 1280
Set Height 720
Set Padding 16
Set Theme "Catppuccin Mocha"
Set TypingSpeed 90ms

Hide
Type "source docs/demos/env.sh && clear"
Enter
Show

Type "fff" Sleep 400ms Enter Sleep 1.5s
Type "+" Sleep 600ms Type "+" Sleep 600ms Type "+" Sleep 1.2s
Type "i" Sleep 300ms Type@200ms "pdestab" Sleep 1.8s
Enter Sleep 2.5s
Type ":q" Sleep 300ms Enter Sleep 800ms
Type "pwd" Sleep 300ms Enter Sleep 2s
