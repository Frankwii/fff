# Trying palettes live: each one shows as it is highlighted.
Output docs/demos/palettes.gif
Require fff
Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 16
Set Width 1280
Set Height 720
Set Padding 16
Set Theme "Catppuccin Mocha"
Set TypingSpeed 90ms

Hide
Type "source docs/demos/env.sh && clear"
Enter
Show

Type "fff --depth 2" Sleep 400ms Enter Sleep 1.5s
Type "gP" Sleep 1s
Type "j" Sleep 900ms Type "j" Sleep 900ms Type "j" Sleep 900ms
Type "j" Sleep 900ms Type "j" Sleep 900ms
Type "i" Sleep 300ms Type@150ms "gruv" Sleep 1.2s
Escape Sleep 300ms Type "j" Sleep 1s Enter Sleep 1.5s
Type "q" Sleep 800ms
